        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"As an Automation Architect use the instrcions in the prompt ,Instructions (user prompt)\\n\\n- Generate ONLY a Selenium Java Code\\n- Use TestNG as the test runner\\n- Add Javadoc for methods & class.\\n- Use Selenium 2.30+ compatible imports.\\n- Use meaningful method names.\\n- [DO NOT] include explanations or test code.\\n- Follow Locator Strategies\\n  - Use ID only when it is unique and do not have numbers in it\\n  - Use NAME only if ID is not present and when it is unique\\n  - Use XPath (preferably attribute based or text based)\\n  - [NEVER] use CSS\\n  - Use Explicit wait No (No thread.sleep)\"\n    },\n    {\n      \"role\": \"system\",\n      \"content\": \"As an AI Assistant give me a selenium java code with TestNG\"\n    },\n    {\n      \"role\": \"assistant\",\n      \"content\": \"only Java selenium code should be displayed along with the comments\"\n    }\n  ]\n}\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://api.groq.com/openai/v1/chat/completions",
          "protocol": "https",
          "host": [
            "api",
            "groq",
            "com"
          ],
